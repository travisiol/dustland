# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://verdict.fun

# --- Contracts ----------------------------------------------------------
# Leave both addresses unset until deployment. With either unset the app is
# in PREVIEW: the docket shows a labelled sample, the launch form and trade
# widget are disabled and say so.
NEXT_PUBLIC_VERDICT_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_VERDICT_ROUTER_ADDRESS=
# Must be true AND both addresses set before anything writes to the chain.
NEXT_PUBLIC_VERDICT_LIVE=false

# --- Robinhood Chain ----------------------------------------------------
# Defaults live in src/lib/chain.ts and must be re-verified against
# docs.robinhood.com/chain before mainnet use. A private RPC is strongly
# advised: the docket polls the registry and pool prices every 20 seconds.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Official channels (hidden from the footer while unset) ------------
NEXT_PUBLIC_VERDICT_X=
NEXT_PUBLIC_VERDICT_TELEGRAM=
NEXT_PUBLIC_VERDICT_DISCORD=
NEXT_PUBLIC_VERDICT_GITHUB=
