# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://streak.example

# --- The game -------------------------------------------------------------
# Leave the address unset until the contract is deployed. With it unset the
# page sits in pre-launch: every figure is a real zero and the check-in
# button is disabled and says so.
NEXT_PUBLIC_STREAK_CONTRACT_ADDRESS=
# Entry fee per check-in in ETH, e.g. 0.001. Once live the contract's own
# entryFee() is used instead and this is only a fallback.
NEXT_PUBLIC_STREAK_ENTRY_ETH=
# Needs to be true AND an address AND an entry before check-ins enable.
NEXT_PUBLIC_STREAK_LIVE=false

# --- Chain ----------------------------------------------------------------
# 8453 = Base (default), 84532 = Base Sepolia, 1 = Ethereum mainnet.
NEXT_PUBLIC_STREAK_CHAIN_ID=8453
# Optional private RPC. Falls back to the chain's public endpoint, which
# will rate-limit under real traffic: the page polls every 20 seconds.
NEXT_PUBLIC_STREAK_RPC_URL=

# --- Socials (hidden from the footer while unset) -------------------------
NEXT_PUBLIC_STREAK_X=
NEXT_PUBLIC_STREAK_DISCORD=
NEXT_PUBLIC_STREAK_TELEGRAM=
