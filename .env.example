# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://alloy.example

# --- Contracts ------------------------------------------------------------
# Leave both addresses unset until deployed. With the factory unset the site
# runs on preview data (labelled Preview everywhere) and every write button
# is disabled and says why.
NEXT_PUBLIC_ALLOY_FACTORY_ADDRESS=
NEXT_PUBLIC_ALLOY_USDG_ADDRESS=
# Needs to be true AND both addresses before forging, buying or redeeming
# enables.
NEXT_PUBLIC_ALLOY_LIVE=false

# --- Robinhood Chain --------------------------------------------------------
# Defaults live in src/lib/chain.ts and must be re-verified against
# docs.robinhood.com/chain before mainnet use.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Socials (hidden from the footer while unset) ---------------------------
NEXT_PUBLIC_ALLOY_X=
NEXT_PUBLIC_ALLOY_DISCORD=
NEXT_PUBLIC_ALLOY_DOCS=
