# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://dustland.example

# --- Claiming -----------------------------------------------------------
# Leave the address unset until the contract is deployed. With it unset the
# map draws placeholder claims behind a PREVIEW tag and the claim button is
# disabled.
NEXT_PUBLIC_DUSTLAND_CONTRACT_ADDRESS=
# Price per parcel in ETH, e.g. 0.04. Unset renders as "Not set".
NEXT_PUBLIC_DUSTLAND_PRICE_ETH=
# Needs to be true AND a contract AND a price before claiming enables.
NEXT_PUBLIC_DUSTLAND_LIVE=false
# Only used while the contract address is unset.
NEXT_PUBLIC_DUSTLAND_PLACEHOLDER_CLAIMS=3
NEXT_PUBLIC_DUSTLAND_MAX_PER_WALLET=5

# Optional private RPC. Falls back to the public mainnet endpoint.
NEXT_PUBLIC_MAINNET_RPC_URL=

# --- Socials (hidden from the footer while unset) -----------------------
NEXT_PUBLIC_DUSTLAND_X=
NEXT_PUBLIC_DUSTLAND_DISCORD=
